{
  "name": "atlas-195",
  "version": "2.0.0",
  "private": true,
  "description": "Atlas interativo dos 195 países, com bandeiras, capitais, localização e revisão adaptativa.",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "check": "npm run test && npm run build && npm run budget && npm run data:freshness",
    "serve": "node scripts/serve.cjs",
    "icons": "node scripts/make-icons.cjs",
    "indicators": "node scripts/update-indicators.cjs",
    "budget": "node scripts/check-budgets.cjs",
    "data:freshness": "node scripts/check-data-freshness.cjs --strict",
    "verify:production": "node scripts/verify-production.cjs"
  },
  "engines": {
    "node": ">=22"
  }
}
